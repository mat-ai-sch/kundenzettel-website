{
  "name": "portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:order": "npx --yes tsx src/orderFromChat.test.ts",
    "test:order:stress": "npx --yes tsx src/orderFromChat.stress.test.ts",
    "test:anna": "npx --yes tsx src/annaBot.test.ts",
    "test:dialog": "npx --yes tsx src/annaDialogRules.test.ts",
    "test:agent": "npx --yes tsx src/annaAgent.test.ts",
    "test:refs": "npx --yes tsx src/referenceImages.test.ts",
    "test:runtime": "npx --yes tsx src/runtimeMode.test.ts",
    "test:landing": "tsx src/landingCopy.test.ts && tsx src/publicHost.test.ts && tsx --tsconfig tsconfig.app.json src/landingPresentation.test.tsx",
    "test": "npm run test:order && npm run test:dialog && npm run test:agent && npm run test:anna && npm run test:refs && npm run test:runtime && npm run test:landing",
    "preview": "vite preview"
  },
  "dependencies": {
    "html2pdf.js": "^0.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
