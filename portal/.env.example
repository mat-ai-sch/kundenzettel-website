# Runtime boundary — the safe default is always the public preview.
# GitHub Pages must build with VITE_RUNTIME_MODE=preview.
VITE_RUNTIME_MODE=preview

# Protected operator build (app.kundenzettel.de) only:
# VITE_RUNTIME_MODE=operator
# VITE_OPERATOR_API_BASE=/api
# VITE_OPERATOR_EVENTS=true
#
# The browser must never receive a Meta token, App Secret, WABA ID, or Phone
# Number ID. Those values exist solely as encrypted Worker secrets.
#
# Optional preview-only Anna agent. It is ignored by operator message delivery.
# VITE_ANNA_AGENT_ENDPOINT=https://your-proxy.example/api/anna
